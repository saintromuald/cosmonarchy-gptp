<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <!--
    bw::Dialog: use the `type` discriminator to expose the correct payload
    from each of the four safeunion::Union storage blobs.

    Notes:
      - Every cast/union item is Optional, so one failing expression hides
        that item instead of dropping the whole type to its raw form.
      - Conditions compare against scoped enumerators (DialogControlType is
        enum class), which the expression evaluator resolves directly.

    Mapping (see bw::Dialog in BW/structures/ui_structures.h):

      union_text (0x14):
        DialogBoxDC, DefaultButton, Button, OptionButton, CheckBox, Image,
        LabelLeftAlign, LabelCenterAlign, LabelRightAlign, LightUpButton -> const char*
        TextInput -> std::array<char, 256>*

      union_data (0x36):
        DialogBoxDC          -> MenuData
        OptionButton         -> SelectionButtonData
        CheckBox             -> SelectionButtonData
        HorizontalScrollBar  -> SliderData
        VerticalScrollBar    -> SliderData
        TextInput            -> TextInputData
        ListBox              -> ListOrComboData
        ComboBox             -> ListOrComboData
        LightUpButton        -> LightUpButtonData

      union_child (0x42):
        DialogBoxDC          -> Dialog*
        ListBox              -> u32*
        LightUpButton        -> LightUpButtonAnimation*

      union_extra (0x46):
        ListBox              -> ListOrComboExtra
        ComboBox             -> ListOrComboExtra
        LightUpButton        -> LightUpButtonExtra
  -->
  <Type Name="bw::Dialog">
    <DisplayString>{{ type={type,en} index={index} }}</DisplayString>

    <Expand>
      <Item Name="next">next</Item>
      <Item Name="bounds">bounds</Item>
      <Item Name="bitmap">bitmap</Item>
      <Item Name="flags">flags</Item>
      <Item Name="delay_timer">delay_timer</Item>
      <Item Name="unknown_1e">unknown_1e</Item>
      <Item Name="index">index</Item>
      <Item Name="type">type</Item>
      <Item Name="graphic">graphic</Item>
      <Item Name="user">user</Item>
      <Item Name="interaction_function">interaction_function</Item>
      <Item Name="draw_function">draw_function</Item>
      <Item Name="parent">parent</Item>

      <!-- 0x14  union_text: every entry except TextInput is a const char* -->
      <Item Name="[text]" Optional="true"
            Condition="type == DialogControlType::DialogBoxDC || type == DialogControlType::DefaultButton || type == DialogControlType::Button || type == DialogControlType::OptionButton || type == DialogControlType::CheckBox || type == DialogControlType::Image || type == DialogControlType::LabelLeftAlign || type == DialogControlType::LabelCenterAlign || type == DialogControlType::LabelRightAlign || type == DialogControlType::LightUpButton">
        *(const char*)&amp;union_text,sb
      </Item>

      <!-- 0x36  union_data -->
      <Item Name="[data: MenuData]" Optional="true"
            Condition="type == DialogControlType::DialogBoxDC">
        *(bw::MenuData*)&amp;union_data
      </Item>
      <Item Name="[data: SelectionButtonData]" Optional="true"
            Condition="type == DialogControlType::OptionButton">
        *(bw::SelectionButtonData*)&amp;union_data
      </Item>
      <Item Name="[data: SelectionButtonData]" Optional="true"
            Condition="type == DialogControlType::CheckBox">
        *(bw::SelectionButtonData*)&amp;union_data
      </Item>
      <Item Name="[data: SliderData]" Optional="true"
            Condition="type == DialogControlType::HorizontalScrollBar">
        *(bw::SliderData*)&amp;union_data
      </Item>
      <Item Name="[data: SliderData]" Optional="true"
            Condition="type == DialogControlType::VerticalScrollBar">
        *(bw::SliderData*)&amp;union_data
      </Item>
      <Item Name="[data: TextInputData]" Optional="true"
            Condition="type == DialogControlType::TextInput">
        *(bw::TextInputData*)&amp;union_data
      </Item>
      <Item Name="[data: ListOrComboData]" Optional="true"
            Condition="type == DialogControlType::ListBox">
        *(bw::ListOrComboData*)&amp;union_data
      </Item>
      <Item Name="[data: ListOrComboData]" Optional="true"
            Condition="type == DialogControlType::ComboBox">
        *(bw::ListOrComboData*)&amp;union_data
      </Item>
      <Item Name="[data: LightUpButtonData]" Optional="true"
            Condition="type == DialogControlType::LightUpButton">
        *(bw::LightUpButtonData*)&amp;union_data
      </Item>

      <!-- 0x42  union_child -->
      <Item Name="[child: Dialog*]" Optional="true"
            Condition="type == DialogControlType::DialogBoxDC">
        *(bw::Dialog**)&amp;union_child
      </Item>
      <Item Name="[child: scrollbar u32*]" Optional="true"
            Condition="type == DialogControlType::ListBox">
        *(unsigned int**)&amp;union_child
      </Item>
      <Item Name="[child: LightUpButtonAnimation*]" Optional="true"
            Condition="type == DialogControlType::LightUpButton">
        *(bw::LightUpButtonAnimation**)&amp;union_child
      </Item>

      <!-- 0x46  union_extra -->
      <Item Name="[extra: ListOrComboExtra]" Optional="true"
            Condition="type == DialogControlType::ListBox">
        *(bw::ListOrComboExtra*)&amp;union_extra
      </Item>
      <Item Name="[extra: ListOrComboExtra]" Optional="true"
            Condition="type == DialogControlType::ComboBox">
        *(bw::ListOrComboExtra*)&amp;union_extra
      </Item>
      <Item Name="[extra: LightUpButtonExtra]" Optional="true"
            Condition="type == DialogControlType::LightUpButton">
        *(bw::LightUpButtonExtra*)&amp;union_extra
      </Item>

      <!-- Raw storage always available for inspection -->
      <Item Name="[union_text raw]">union_text</Item>
      <Item Name="[union_data raw]">union_data</Item>
      <Item Name="[union_child raw]">union_child</Item>
      <Item Name="[union_extra raw]">union_extra</Item>
    </Expand>
  </Type>

  <!--
    Fallback for safeunion::Union when it appears outside a bw::Dialog
    context (e.g. as a local). Without the enum discriminator we can't
    pick a specific type, so just show the raw bytes.
  -->
  <Type Name="safeunion::Union&lt;*&gt;">
    <DisplayString>{{ Union(Size={Size}) }}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>Size</Size>
        <ValuePointer>(unsigned char*)data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

</AutoVisualizer>
